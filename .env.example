# ──────────────────────────────────────────────────────────────
# RouteWeave Configuration
# ──────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values

# ── Classifier ────────────────────────────────────────────────
# Model name passed to llama.cpp (optional metadata)
CLASSIFIER_MODEL=phi3:mini

# llama.cpp server API endpoint
LLAMA_CPP_URL=http://localhost:8080

# ── Storage ───────────────────────────────────────────────────
# Redis connection string for budget tracking
REDIS_URL=redis://localhost:6379

# Path to tier configuration file
TIER_CONFIG_PATH=config/tiers.yaml

# ── Auth ──────────────────────────────────────────────────────
# API key to role mapping (format: key1:role1,key2:role2)
ROLE_MAP=

# ── Logging ───────────────────────────────────────────────────
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ── Cloud Providers (add only what you use) ───────────────────
# OpenAI
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Google Gemini
GOOGLE_API_KEY=

# Groq
GROQ_API_KEY=

# Mistral
MISTRAL_API_KEY=
